{
  "name": "gruhswad-admin-desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "icons:win": "node scripts/generate-windows-icon.mjs",
    "pack": "pnpm icons:win && pnpm build && electron-builder --dir",
    "dist": "pnpm icons:win && pnpm build && electron-builder"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "better-sqlite3": "^12.2.0",
    "drizzle-orm": "^0.44.5",
    "electron-updater": "^6.6.2",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "in.gruhswad.admin",
    "productName": "Gruhswad Admin",
    "directories": { "output": "release" },
    "files": ["out/**/*", "drizzle/**/*", "package.json"],
    "asarUnpack": ["node_modules/better-sqlite3/**/*"],
    "win": { "target": ["nsis"], "icon": "build/icon.ico" },
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.business", "icon": "build/icon.icns" },
    "publish": [{ "provider": "github", "owner": "amol-pandhare", "repo": "gruhswad-admin-desktop", "releaseType": "release" }]
  },
  "packageManager": "pnpm@10.15.1"
}
