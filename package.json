{
  "name": "gruhswad-admin-desktop",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "release:verify-tag": "node scripts/verify-release-tag.mjs",
    "native:electron": "electron-rebuild -f -w better-sqlite3",
    "icons:win": "node scripts/generate-windows-icon.mjs",
    "pack": "pnpm native:electron && pnpm icons:win && pnpm build && electron-builder --dir",
    "dist": "pnpm native:electron && pnpm icons:win && pnpm build && electron-builder"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@napi-rs/canvas": "^1.0.6",
    "@neondatabase/serverless": "^1.1.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "better-sqlite3": "^12.2.0",
    "drizzle-orm": "^0.44.5",
    "electron-updater": "^6.6.2",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.2.108",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  },
  "build": {
    "npmRebuild": false,
    "appId": "in.gruhswad.admin",
    "productName": "Gruhswad Admin",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "drizzle/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "drizzle",
        "to": "drizzle"
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/@napi-rs/**/*",
      "node_modules/tesseract.js-core/**/*",
      "node_modules/@tesseract.js-data/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "Gruhswad-Admin-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business",
      "icon": "build/icon.icns",
      "artifactName": "Gruhswad-Admin-${version}-${arch}-mac.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "amol-pandhare",
        "repo": "gruhswad-admin-desktop",
        "releaseType": "release"
      }
    ]
  },
  "packageManager": "pnpm@10.15.1"
}
