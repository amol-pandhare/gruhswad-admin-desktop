# Desktop secrets are entered in Settings and encrypted with Electron safeStorage.
# Do not bundle real credentials in this file.
APP_ENV=local
DATABASE_URL_LOCAL=postgresql://local-development-role
DATABASE_URL_PROD=postgresql://production-least-privilege-role
# Backward-compatible fallback when the selected environment URL is empty.
DATABASE_URL=
WEBHOOK_URL=https://your-webhook.vercel.app
INBOX_API_TOKEN=replace-me
GH_TOKEN=required-only-for-publishing-releases
